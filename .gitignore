# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Secrets and environment variables
.env
.env.*
!.env.example

# Datasets and generated data (keep folder placeholders)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts (often large; track only if intentionally chosen)
models/*
!models/.gitkeep

# Reports generated locally; commit selected final reports/figures intentionally
reports/figures/*
!reports/figures/.gitkeep

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
